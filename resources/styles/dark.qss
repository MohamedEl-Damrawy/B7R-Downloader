/* Velo Downloader - Premium Modern Dark */
QMainWindow, QWidget#Root {
    background-color: @main_bg@;
    color: @text_main@;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}
QWidget#Sidebar {
    background-color: @sidebar@;
    border-right: 1px solid #1e2c40;
}
QPushButton.NavButton {
    background: transparent;
    color: @text_secondary@;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
}
QPushButton.NavButton:hover {
    background-color: @card@;
    color: @text_main@;
}
QPushButton.NavButton[active="true"] {
    background-color: @secondary@;
    color: @text_main@;
}
QFrame.Card, QWidget.Card {
    background-color: @card@;
    border: 1px solid #22344d;
    border-radius: 12px;
}
QLabel.Title {
    font-size: 20px;
    font-weight: 600;
    color: @text_main@;
}
QLabel.Subtitle {
    color: @text_secondary@;
    font-size: 12px;
}
QLineEdit, QComboBox, QTextEdit {
    background-color: #0f1a29;
    border: 1px solid #2a3c56;
    border-radius: 8px;
    padding: 8px 10px;
    color: @text_main@;
}
QPushButton.Primary {
    background-color: @primary@;
    color: #081018;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-weight: 600;
}
QPushButton.Primary:hover { background-color: #47aaaa; }
QPushButton.Danger {
    background-color: @accent@;
    color: @text_main@;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}
QStatusBar {
    background: @sidebar@;
    color: @text_secondary@;
}
