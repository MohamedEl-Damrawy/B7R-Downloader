/* Velo Downloader - Premium Modern Dark */
QMainWindow, QWidget#Root {
    background-color: @main_bg@;
    color: @text_main@;
    font-family: @font_family@;
    font-size: @font_size@;
}
QWidget#Sidebar {
    background-color: @sidebar@;
    border-right: 1px solid #1e2c40;
}
QWidget#Sidebar QLabel#BrandTitle {
    color: @text_main@;
}
QPushButton.NavButton {
    background: transparent;
    color: @text_secondary@;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    /* no explicit text-align: default alignment follows layout direction (RTL-aware) */
}
QPushButton.NavButton:hover {
    background-color: @card@;
    color: @text_main@;
}
QPushButton.NavButton[active="true"] {
    background-color: @secondary@;
    color: @text_main@;
}
QFrame.Card, QWidget.Card {
    background-color: @card@;
    border: 1px solid #2E425E;
    border-radius: 12px;
}
QLabel.Title {
    font-size: 20px;
    font-weight: 600;
    color: @text_main@;
}
QLabel.Subtitle {
    color: @text_secondary@;
    font-size: 12px;
}
/* Explicit base text colors: Qt does not reliably cascade QSS color down
   every widget chain, so unclassed labels/lists must be covered directly. */
QLabel {
    color: @text_main@;
}
QListWidget {
    color: @text_main@;
}
QLabel#StatValue {
    color: @text_main@;
}
QLabel#ThumbPreview {
    color: @text_secondary@;
    background-color: #0f1a29;
    border: 1px solid #2a3c56;
    border-radius: 8px;
}
QLineEdit, QComboBox, QTextEdit, QSpinBox {
    background-color: #0f1a29;
    border: 1px solid #2a3c56;
    border-radius: 8px;
    padding: 8px 10px;
    color: @text_main@;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid @primary@;
}
QComboBox QAbstractItemView {
    background-color: #0f1a29;
    color: @text_main@;
    border: 1px solid #2a3c56;
    selection-background-color: @secondary@;
    selection-color: @text_main@;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QPushButton {
    background-color: #1B2A3E;
    color: @text_main@;
    border: 1px solid #2a3c56;
    border-radius: 8px;
    padding: 8px 12px;
}
QPushButton:hover {
    background-color: #223450;
}
QPushButton:disabled {
    color: #5C6B7E;
    background-color: #141F2E;
    border: 1px solid #22344d;
}
QPushButton.Primary {
    background-color: @primary@;
    color: #081018;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-weight: 600;
}
QPushButton.Primary:hover { background-color: #47aaaa; }
QPushButton.Primary:disabled {
    background-color: #1E3A3A;
    color: #5F7A7A;
    border: none;
}
QPushButton.Danger {
    background-color: @accent@;
    color: @text_main@;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}
QPushButton.Danger:hover { background-color: #D41741; }
QPushButton.Danger:disabled {
    background-color: #4A1B26;
    color: #6E5A60;
    border: none;
}
QListWidget {
    background-color: @card@;
    border: 1px solid #2E425E;
    border-radius: 12px;
    padding: 4px;
}
QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
}
QListWidget::item:hover {
    background-color: #1B2A3E;
}
QListWidget::item:selected {
    background-color: @secondary@;
    color: @text_main@;
    border-radius: 6px;
}
QListWidget::item:selected:hover {
    background-color: #1B567F;
}
QCheckBox {
    spacing: 8px;
    color: @text_main@;
}
QProgressBar {
    background-color: #0f1a29;
    border: 1px solid #2a3c56;
    border-radius: 4px;
}
QProgressBar::chunk {
    background-color: @primary@;
    border-radius: 4px;
}
QLabel#QueueRowTitle {
    color: @text_main@;
    font-weight: 600;
}
QLabel#QueueRowInfo {
    color: @text_secondary@;
    font-size: 12px;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2A3C56;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #3A517A; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2A3C56;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QToolTip {
    background-color: #101A28;
    color: @text_main@;
    border: 1px solid #2E425E;
    padding: 4px 6px;
}
QStatusBar {
    background: @sidebar@;
    color: @text_secondary@;
}
