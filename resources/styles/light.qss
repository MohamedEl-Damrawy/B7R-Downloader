/* Velo Downloader - Clean Light (FEAT-08) */
QMainWindow, QWidget#Root {
    background-color: @main_bg@;
    color: @text_main@;
    font-family: @font_family@;
    font-size: @font_size@;
}
QWidget#Sidebar {
    background-color: @sidebar@;
    border-right: 1px solid #DDE4EC;
}
QWidget#Sidebar QLabel#BrandTitle {
    color: @text_main@;
}
QPushButton.NavButton {
    background: transparent;
    color: @text_secondary@;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    /* no explicit text-align: default alignment follows layout direction (RTL-aware) */
}
QPushButton.NavButton:hover {
    background-color: #EEF2F6;
    color: @text_main@;
}
QPushButton.NavButton[active="true"] {
    background-color: @secondary@;
    color: @text_main@;
}
QFrame.Card, QWidget.Card {
    background-color: @card@;
    border: 1px solid #E2E8EF;
    border-radius: 12px;
}
QLabel.Title {
    font-size: 20px;
    font-weight: 600;
    color: @text_main@;
}
QLabel.Subtitle {
    color: @text_secondary@;
    font-size: 12px;
}
/* Explicit base text colors: Qt does not reliably cascade QSS color down
   every widget chain, so unclassed labels/lists must be covered directly. */
QLabel {
    color: @text_main@;
}
QListWidget {
    color: @text_main@;
}
QLabel#StatValue {
    color: @text_main@;
}
QLabel#ThumbPreview {
    color: @text_secondary@;
    background-color: #F7FAFC;
    border: 1px solid #C9D3DE;
    border-radius: 8px;
}
QLineEdit, QComboBox, QTextEdit, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C9D3DE;
    border-radius: 8px;
    padding: 8px 10px;
    color: @text_main@;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid @primary@;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: @text_main@;
    border: 1px solid #C9D3DE;
    selection-background-color: @secondary@;
    selection-color: @text_main@;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QPushButton {
    background-color: #FFFFFF;
    color: @text_main@;
    border: 1px solid #C9D3DE;
    border-radius: 8px;
    padding: 8px 12px;
}
QPushButton:hover {
    background-color: #EDF2F7;
}
QPushButton:disabled {
    color: #9AA9B8;
    background-color: #F1F4F8;
    border: 1px solid #E2E8EF;
}
QPushButton.Primary {
    background-color: @primary@;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-weight: 600;
}
QPushButton.Primary:hover { background-color: #269492; }
QPushButton.Primary:disabled {
    background-color: #A7CFCE;
    color: #F4F7FA;
    border: none;
}
QPushButton.Danger {
    background-color: @accent@;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}
QPushButton.Danger:hover { background-color: #A81F3B; }
QPushButton.Danger:disabled {
    background-color: #E8B7C1;
    color: #FBF3F5;
    border: none;
}
QListWidget {
    background-color: @card@;
    border: 1px solid #E2E8EF;
    border-radius: 12px;
    padding: 4px;
}
QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
}
QListWidget::item:hover {
    background-color: #EDF2F7;
}
QListWidget::item:selected {
    background-color: @secondary@;
    color: @text_main@;
    border-radius: 6px;
}
QListWidget::item:selected:hover {
    background-color: #C3DBEE;
}
QCheckBox {
    spacing: 8px;
    color: @text_main@;
}
QProgressBar {
    background-color: #EDF1F5;
    border: 1px solid #C9D3DE;
    border-radius: 4px;
}
QProgressBar::chunk {
    background-color: @primary@;
    border-radius: 4px;
}
QLabel#QueueRowTitle {
    color: @text_main@;
    font-weight: 600;
}
QLabel#QueueRowInfo {
    color: @text_secondary@;
    font-size: 12px;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #C4CFDA;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #A9B8C6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #C4CFDA;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QToolTip {
    background-color: #FFFFFF;
    color: @text_main@;
    border: 1px solid #C9D3DE;
    padding: 4px 6px;
}
QStatusBar {
    background: @sidebar@;
    color: @text_secondary@;
}
